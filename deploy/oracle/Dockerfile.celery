FROM python:3.12-slim-bookworm
WORKDIR /app
COPY mule_parser/requirements.txt /app/mule_parser/requirements.txt
RUN pip install --no-cache-dir -r /app/mule_parser/requirements.txt
COPY mule_parser /app/mule_parser
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
CMD ["celery", "-A", "mule_parser.api.celery_app:celery_app", "worker", "--loglevel=info", "--concurrency=1"]
