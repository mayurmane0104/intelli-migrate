FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY mule_parser/requirements.txt /app/mule_parser/requirements.txt
RUN pip install --no-cache-dir -r /app/mule_parser/requirements.txt

COPY mule_parser /app/mule_parser

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "mule_parser.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
